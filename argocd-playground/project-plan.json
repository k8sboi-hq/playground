    "cluster_mode": "single-cluster",
    "multi_tenancy": true
  },
  "teams": [
    {
      "name": "platform",
      "namespace": "platform",
      "description": "Platform team managing shared infrastructure"
    },
    {
      "name": "team-alpha",
      "namespace": "team-alpha",
      "description": "Application team A"
    },
    {
      "name": "team-beta",
      "namespace": "team-beta",
      "description": "Application team B"
    }
  ],
