{
  "project": {
    "name": "argocd-playground",
    "description": "GitOps playground with ArgoCD, multi-tenancy, Vault integration, and full CI/CD cycle",
    "version": "0.1.0",
    "created_at": "2026-01-31",
    "updated_at": "2026-01-31"
  },
  "config": {
    "pattern": "app-of-apps",
    "secrets_backend": "hashicorp-vault",
